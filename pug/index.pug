extends partial/_page


//--------------------------------------------------------\\
//- ---------------- Mixins of goodness ---------------- -\\
//--------------------------------------------------------\\

mixin paper(thumbnail, title, authors, venue, projectUrl, paperUrl)
  .publication
    img.pub-thumbnail(src=thumbnail alt=title)
    .pub-info
      .pub-title
          a(href=projectUrl)= title
      .pub-authors!= authors.replace('Linas Beresna', '<strong>Linas Beresna</strong>')
      .pub-venue= venue
    .pub-buttons
      a.pub-btn(href=projectUrl) Project
      a.pub-btn(href=paperUrl) Paper

mixin socials
  .socials.links
    div.title Socials
    div.horizontal_line
    div.list
      a(href="https://github.com/LinasBeres") Github
      a(href="https://uk.linkedin.com/in/linas-beresna") LinkedIn
      a(href="./views/contact.html") Contact

mixin resume
  .resume.links
    div.title Resume
    div.horizontal_line
    div.list
      a(href="./views/resume.html") <s>Pretty</s>
      a(href="./files/linas-beresna-cv.pdf") Simple

mixin interests
  .interests.links
    div.title Interests
    div.horizontal_line
    div.list
      a(href="./views/graphics.html") <s>Graphics!</s>
      a(href="./views/motorbiking.html") Motorbiking

//-----------------------------------------------------------\\
//- ----------------- Main Page Extensions ---------------- -\\
//-----------------------------------------------------------\\
append meta
  title Home | Linas Beresna

append styles
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
  link(rel="stylesheet" href="./stylesheets/styles.css")

block body
  div.pageContent
    div.holder
      a(href="./index.html")
        img.me(src='./images/me.jpg')
      +content("Linas Beresna")
        - var gruvi = '<a href="https://gruvi.cs.sfu.ca/">GrUVi</a>'
        - var eugene = '<a href="https://www.dgp.toronto.edu/~elf/">Eugene Fiume</a>'
        - var tobias = '<a href="https://www.homepages.ucl.ac.uk/~ucactri/">Tobias Ritschel</a>'
        p Hello hello! I'm a PhD student at !{gruvi} labs at SFU and am supervised by !{eugene}. My research is in visualisation, photorealistic rendering, austere graphics and differentiable rendering. I did my masters at UCL under !{tobias} and have worked for a couple of years in the VFX and animation industry.
      div.inline
        +socials
        +resume
        +interests
    div.publications-holder
      +content("Publications")
        +paper('./images/papers/placeholder.jpg', 'Glare Mitigation using a Differentiable Unified Glare Rating', 'Linas Beresna, Eugene Fiume', 'Eurographics Symposium on Rendering (EGSR), 2026', './views/egsr2026.html', './files/papers/egsr2026.pdf')

append scripts
  script(src="js/form.js")
  script(src="js/time.js")
  script(src="js/index.js")
