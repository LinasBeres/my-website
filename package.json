{
  "name": "my-website",
  "version": "1.0.0",
  "description": "Dev code for my website",
  "scripts": {
    "build:html": "pug pug/ --out .",
    "build:css": "sass sass/styles.sass stylesheets/styles.css",
    "build": "npm run build:html && npm run build:css",
    "watch:html": "pug pug/ --out . --watch",
    "watch:css": "sass sass/styles.sass stylesheets/styles.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinasBeres/my-website.git"
  },
  "author": "Linas Beresna",
  "license": "MIT",
  "devDependencies": {
    "pug-cli": "^1.0.0-alpha6",
    "sass": "1.77.8"
  }
}
