extends _view

append styles
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css")
  link(rel="stylesheet" href="../stylesheets/styles.css")

append scripts
  script(src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js")
  script(src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js")
  script(src="../js/project.js")

block view-body
  div.pageContent
    div.project-holder

      .project-header
        block project-header

      .project-teaser
        block teaser

      +content("Abstract")
        block abstract

      .project-resource-row
        block resources

      block figures-section
        +content("Figures")
          block figures

      .citation-section#citation
        .citation-label Citation
        .citation-text-box
          block citation-text
        .citation-bibtex-label BibTeX
        .bibtex-box
          pre
            block citation-bibtex
